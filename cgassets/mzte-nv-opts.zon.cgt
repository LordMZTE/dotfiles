<!
    tmpl:setAssumeDeterministic(true)
    local zon = require "lib.confgen.zon"
!>
.{
    .nix = <% zon.serialize(opt.nix) %>,
    .textwidth = <% opt.textwidth %>,

    .font = "<% opt.term_font %>:h<% opt.mulFontSize(12) %>",

    .openai_endpoints = .{
        <! for _, remote in ipairs(opt.openai_endpoints) do !>
        <% zon.serialize(remote) %>,
        <! end !>
    },
}
