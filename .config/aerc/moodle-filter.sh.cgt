#!/bin/sh
# This script will process the extremely confusing emails my Uni's moodle instance sends in order to
# provide a human-readable name for classes which are only identified by a number in EMails
# (yes, really).
<!
  tmpl:setMode "755"
  local class_map = {
    [19035] = "Systemsoftware",
    [19018] = "VL Einführung in die Wahrscheinlichkeitstheorie",
    [19019] = "ÜB Einführung in die Wahrscheinlichkeitstheorie",
    [19051] = "Berechenbarkeit und Komplexität",
    [17859] = "Computational Physics I",
    [15540] = "VL Elektronik",
    [180750] = "ÜB Elektronik",
    [206788] = "Information Retrieval",
    [154240] = "Berechenbarkeit und Komplexität",
    [76735] = "[Work] Grundlagen informatischer Problemlösung",
  }

  local ansi_yellow = "\x1b[0;33m"
  local ansi_reset = "\x1b[0m"
!>
exec sed \<! for num, name in pairs(class_map) do !>
    -e 's/<% num %>/<% ansi_yellow %><<% num %>: <% name %>><% ansi_reset %>/g' \<! end !>
