<! tmpl:setCacheTime(0) !>
default_profile = "main"

[profiles.main]
user_id = "<% opt.matrix.mxid %>"

[settings]
username_display = "displayname"
user_gutter_width = 16
normal_after_send = true

# This isn't for a slow server, this is for when the client has bad internet, in which case it often
# can't get the sync done in the standard two minute timeout.  Still think this protocol is any
# good?
request_timeout = <% 4 * 60 * 60 %>

<! if not opt.safe_mode then !>
<! local img_proto = (fsctx and opt.termSupportsKittyImages(fsctx:getCallerEnv().TERM)) and "kitty" or "sixel" !>
image_preview = { protocol = { type = "<% img_proto %>" } }
<! end !>

[settings.sort]
rooms = ["favorite", "recent"]

[dirs]
downloads = "/tmp/iamb_dl_<% opt.lazy.username() %>"

[macros.normal]
"gr" = ":replied<Enter>"
"go" = ":open<Enter>"
"gi" = ":message<Enter>"
"fu" = ":unreads<Enter>"
"fc" = ":chats<Enter>"
"fr" = ":unreads clear<Enter>"
